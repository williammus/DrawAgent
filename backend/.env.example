APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:5173
LOG_LEVEL=INFO
TEMP_DIR=./tmp
SESSION_TTL_SECONDS=1800
SESSION_CLEANUP_INTERVAL_SECONDS=300
MAX_SESSION_FILES=10
MAX_SESSION_FILE_SIZE_MB=25
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
WORKFLOW_MAX_ERROR_COUNT=3
# Use `mock` for local smoke tests.
# Switch to `nano_banana2` to call the real image provider.
IMAGE_PROVIDER=mock
IMAGE_API_KEY=
IMAGE_BASE_URL=
# Gemini models use Google native `generateContent`.
# Non-Gemini models continue to use OpenAI-compatible Images API.
IMAGE_MODEL=gemini-3-pro-image-preview-4k
IMAGE_TIMEOUT_SECONDS=120
SSE_HEARTBEAT_SECONDS=15
