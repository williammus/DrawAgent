# Global default LLM provider
# This acts as the final fallback for all roles.
# OpenAI-compatible examples:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_MODE=chat_completions
#   LLM_MODEL=gpt-4o-mini
#
# Gemini generateContent example:
#   LLM_BASE_URL=https://sg.uiuiapi.com/v1
#   LLM_API_MODE=gemini_generate_content
#   LLM_MODEL=gemini-3-pro-preview
#
# Mixed-role example:
#   controller/reviewer -> gpt-5.4 + responses
#   workers           -> gemini-3-pro-preview + gemini_generate_content
#   image             -> gemini image endpoint
# In that case:
#   LLM_API_MODE=responses
#   LLM_MODEL=gpt-5.4
#   CONTROLLER_API_MODE=responses
#   CONTROLLER_MODEL=gpt-5.4
#   REVIEWER_API_MODE=responses
#   REVIEWER_MODEL=gpt-5.4
#   WORKER_API_MODE=gemini_generate_content
#   WORKER_MODEL=gemini-3-pro-preview
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_API_MODE=chat_completions
LLM_MODEL=gpt-4o-mini

# Optional shared worker fallback
# All virtual worker roles can inherit from these if no role-specific value is set.
WORKER_BASE_URL=${LLM_BASE_URL}
WORKER_API_KEY=${LLM_API_KEY}
WORKER_API_MODE=${LLM_API_MODE}
WORKER_MODEL=${LLM_MODEL}

# Controller role
CONTROLLER_BASE_URL=${LLM_BASE_URL}
CONTROLLER_API_KEY=${LLM_API_KEY}
CONTROLLER_API_MODE=${LLM_API_MODE}
CONTROLLER_MODEL=${LLM_MODEL}

# Reviewer role
# Backward-compatible aliases REVIEW_* are also supported in code.
REVIEWER_BASE_URL=${LLM_BASE_URL}
REVIEWER_API_KEY=${LLM_API_KEY}
REVIEWER_API_MODE=${LLM_API_MODE}
REVIEWER_MODEL=${LLM_MODEL}
REVIEW_BASE_URL=${REVIEWER_BASE_URL}
REVIEW_API_KEY=${REVIEWER_API_KEY}
REVIEW_API_MODE=${REVIEWER_API_MODE}
REVIEW_MODEL=${REVIEWER_MODEL}

# Built-in prompt roles
# Each role can independently override MODEL / BASE_URL / API_KEY / API_MODE.
LOGIC_EXTRACTION_BASE_URL=${WORKER_BASE_URL}
LOGIC_EXTRACTION_API_KEY=${WORKER_API_KEY}
LOGIC_EXTRACTION_API_MODE=${WORKER_API_MODE}
LOGIC_EXTRACTION_MODEL=${WORKER_MODEL}

STYLE_EXTRACTION_BASE_URL=${WORKER_BASE_URL}
STYLE_EXTRACTION_API_KEY=${WORKER_API_KEY}
STYLE_EXTRACTION_API_MODE=${WORKER_API_MODE}
STYLE_EXTRACTION_MODEL=${WORKER_MODEL}

VISUAL_MAPPING_BASE_URL=${WORKER_BASE_URL}
VISUAL_MAPPING_API_KEY=${WORKER_API_KEY}
VISUAL_MAPPING_API_MODE=${WORKER_API_MODE}
VISUAL_MAPPING_MODEL=${WORKER_MODEL}

SUMMARIZATION_BASE_URL=${WORKER_BASE_URL}
SUMMARIZATION_API_KEY=${WORKER_API_KEY}
SUMMARIZATION_API_MODE=${WORKER_API_MODE}
SUMMARIZATION_MODEL=${WORKER_MODEL}

# Image generation provider
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_API_MODE=openai_images
IMAGE_MODEL=gpt-image-1

# Runtime
RUNTIME_DIR=./runtime
UPLOAD_STORE_DIR=./runtime/uploads
OUTPUT_STORE_DIR=./runtime/outputs
ARTIFACT_STORE_DIR=./runtime/artifacts

# MCP review server
REVIEW_MCP_COMMAND=
REVIEW_MCP_ARGS=
REVIEW_MCP_TIMEOUT_SECONDS=120
